						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "enrichedSilverLayer",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"BronzeLayerRawData": {},
									"SinkToSilverLayer": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
