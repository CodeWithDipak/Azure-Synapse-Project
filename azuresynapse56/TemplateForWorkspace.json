		{
			"name": "[concat(parameters('workspaceName'), '/DimensionTables')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "---------------\n-- dimCustomer \n---------------\nIF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id\n                WHERE t.name = 'dimCustomer' and s.name = 'gold')\n    CREATE EXTERNAL TABLE gold.dimCustomer\n    WITH(\n        LOCATION = 'dimCustomer',\n        DATA_SOURCE = gold_layer,\n        FILE_FORMAT = parquetFormat\n    )\n    AS\n    SELECT *, ROW_NUMBER() OVER(ORDER BY CustomerID) AS DimCustomerKey\n    FROM\n    (SELECT\n        DISTINCT\n        CustomerID,\n        FirstName,\n        LastName,\n        CustomerEmail\n    FROM\n        silver.silverTable\n    ) AS C\n\n--------------\n-- dimProduct \n--------------\nIF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id\n                WHERE t.name = 'dimProduct' and s.name = 'gold')\n    CREATE EXTERNAL TABLE gold.dimProduct\n    WITH(\n        LOCATION = 'dimProduct',\n        DATA_SOURCE = gold_layer,\n        FILE_FORMAT = parquetFormat\n    )\n    AS\n    SELECT *, ROW_NUMBER() OVER(ORDER BY ProductID) AS DimProductKey\n    FROM\n    (SELECT\n        DISTINCT\n        ProductID,\n        ProductName,\n        ProductCategory\n    FROM\n        silver.silverTable\n    ) AS P\n\n----------------\n-- dimRegion\n----------------\nIF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id\n                WHERE t.name = 'dimRegion' and s.name = 'gold')\n    CREATE EXTERNAL TABLE gold.dimRegion\n    WITH(\n        LOCATION = 'dimRegion',\n        DATA_SOURCE = gold_layer,\n        FILE_FORMAT = parquetFormat\n    )\n    AS\n    SELECT *, ROW_NUMBER() OVER(ORDER BY RegionID) AS DimRegionKey\n    FROM\n    (\n    SELECT\n        DISTINCT\n        RegionID,\n        RegionName,\n        country\n    FROM\n        silver.silverTable\n    ) AS R\n\n-------------\n-- dimOrder\n-------------\nIF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id\n                WHERE t.name = 'dimOrder' and s.name = 'gold')\n    CREATE EXTERNAL TABLE gold.dimOrder\n    WITH(\n        LOCATION = 'dimOrder',\n        DATA_SOURCE = gold_layer,\n        FILE_FORMAT = parquetFormat\n    )\n    AS\n    SELECT *, ROW_NUMBER() OVER(ORDER BY OrderID) AS DimOrderKey\n    FROM\n    (SELECT\n        DISTINCT\n        OrderID,\n        OrderDate,\n        CustomerID,\n        FirstName,\n        LastName,\n        CustomerEmail,\n        ProductID,\n        ProductName,\n        ProductCategory,\n        RegionID,\n        RegionName,\n        country\n    FROM\n        silver.silverTable\n    ) AS O\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "synapseDWH",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/FactOrders')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "--------------\n-- factOrders\n-------------\nIF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id\nWHERE t.name = 'factOrders' and s.name = 'gold')\n    CREATE EXTERNAL TABLE gold.factOrders\n    WITH(\n        LOCATION = 'factOrders',\n        DATA_SOURCE = gold_layer,\n        FILE_FORMAT = parquetFormat\n    )\n    AS\n    (SELECT\n        C. DimCustomerKey,\n        P.DimProductKey,\n        R.DimRegionKey,\n        O.DimOrderKey,\n        Quantity,\n        UnitPrice,\n        TotalAmount\n    FROM silver.silverTable F\n    LEFT JOIN gold.dimCustomer C ON F.CustomerID = C.CustomerID\n    LEFT JOIN gold.dimProduct P ON F.ProductID = P.ProductID\n    LEFT JOIN gold.dimRegion R ON F.RegionID = R.RegionID and F.Country = R.Country\n    LEFT JOIN gold.dimOrder O ON F.OrderID = O.OrderID\n    )\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "synapseDWH",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/externalResourceScript')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "CREATE OR ALTER PROCEDURE dbo.CreateExternalDataSources\n    @storageAccountUrl NVARCHAR(200)\nAS\nBEGIN\n    DECLARE @sql NVARCHAR(MAX);\n\n    IF NOT EXISTS (SELECT * FROM sys.database_scoped_credentials WHERE name = 'my_credentials')\n    BEGIN\n        -- It helps synapse to authenticate the ADLS Gen2\n        CREATE DATABASE SCOPED CREDENTIAL my_credentials\n        WITH IDENTITY = 'Managed Identity';\n    END\n\n    IF EXISTS (SELECT * FROM sys.external_data_sources WHERE name = 'silver_layer')\n        DROP EXTERNAL DATA SOURCE silver_layer;\n    \n    -- external data source is the original location of our data\n    SET @sql = N'CREATE EXTERNAL DATA SOURCE silver_layer\n    WITH (\n        LOCATION = ''' + @storageAccountUrl + '/silver/'',\n        CREDENTIAL = my_credentials\n    );';\n    EXEC sp_executesql @sql;\n\n    IF EXISTS (SELECT * FROM sys.external_data_sources WHERE name = 'gold_layer')\n        DROP EXTERNAL DATA SOURCE gold_layer;\n\n    SET @sql = N'CREATE EXTERNAL DATA SOURCE gold_layer\n    WITH (\n        LOCATION = ''' + @storageAccountUrl + '/gold/'',\n        CREDENTIAL = my_credentials\n    );';\n    EXEC sp_executesql @sql;\n\n    IF NOT EXISTS (SELECT * FROM sys.external_file_formats WHERE name = 'parquetFormat')\n    BEGIN\n        -- File format in which data is stored\n        CREATE EXTERNAL FILE FORMAT parquetFormat\n        WITH (FORMAT_TYPE = PARQUET);\n    END\nEND",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "synapseDWH",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
